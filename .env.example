# Copiar a .env; los valores "test" son credenciales ficticias para el emulador.
# python-dotenv NO sobrescribe variables ya exportadas en la terminal.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
GROUP_ID=grupo01
QUEUE_PREFIX=fenix-grupo01
PROJECT=fenix
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# console | telegram | slack  (el grupo usa telegram; console es el default local)
NOTIFY_PROVIDER=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
# Imagen adoptada: la del Lab-1 de la cátedra (Community, sin token).
# Las imágenes 2026.03+ exigen LOCALSTACK_AUTH_TOKEN; si se adopta una, completarlo.
LOCALSTACK_IMAGE=localstack/localstack:3.8.0
LOCALSTACK_AUTH_TOKEN=
